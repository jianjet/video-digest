# Copy to .env beside this file (the repo root). .gitignore keeps .env out of git: never commit it, it holds the webhook secret.
# A .env in the output folder (~/video-digest/.env) overrides this one.
# A value set as a real environment variable (e.g. with setx) wins over this file.

# Speech engine: sensevoice (default, downloads itself) or qwen3 (download its model folder first)
ASR_ENGINE=sensevoice

# Frames Claude looks at, per reel
SCENE_THRESHOLD=0.30
FRAME_EVERY_SEC=3
MAX_FRAMES=20
FRAME_WIDTH=1080

# Transcripts with fewer words per minute than this get a "may be unreliable" label
MIN_WORDS_PER_MIN=40

# Brain: the Topics folder inside your Obsidian vault (a git repo)
BRAIN_PATH=

# Approval: your n8n webhook and its secret
N8N_WEBHOOK_URL=
IGDIGEST_SECRET=